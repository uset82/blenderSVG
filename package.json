{
  "name": "blendersvg",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Infinite Canvas Studio with high-fidelity vectorization, open AI models, and Blender 3D/2D pipeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uset82/blenderSVG.git"
  },
  "homepage": "https://github.com/uset82/blenderSVG#readme",
  "bugs": {
    "url": "https://github.com/uset82/blenderSVG/issues"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "vitest run",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "package": "node scripts/package-extension.mjs",
    "dev:extension": "pnpm --filter ./apps/extension watch",
    "dev:studio": "pnpm --filter @codex-avatar-studio/studio dev",
    "studio": "pnpm --filter @codex-avatar-studio/studio-server start",
    "build:studio": "pnpm --filter @codex-avatar-studio/studio build",
    "build:web": "pnpm --filter \"@codex-avatar-studio/studio^...\" build && pnpm --filter @codex-avatar-studio/studio build:web",
    "package:vsix": "pnpm run package",
    "smoke:webview": "node scripts/smoke-webview-render.mjs",
    "smoke:blender": "pnpm --filter @codex-avatar-studio/studio-host-core... build && pnpm --filter codex-avatar-studio-extension build && node scripts/smoke-blender-host.mjs",
    "smoke:vsix": "node scripts/smoke-installed-vsix.mjs",
    "smoke:clean-profile": "node scripts/smoke-clean-profile-install.mjs",
    "smoke:offline-studio": "node scripts/smoke-offline-studio.mjs",
    "smoke:studio-conversations": "node scripts/smoke-live-studio-conversations.mjs",
    "smoke:studio-openrouter": "node scripts/smoke-live-studio-openrouter.mjs",
    "smoke:studio-avatar-package": "node --experimental-strip-types scripts/smoke-live-studio-avatar-package.mjs",
    "test:e2e:studio": "node scripts/studio-journey-e2e.mjs",
    "test:a11y:studio": "node scripts/studio-a11y-e2e.mjs",
    "setup:blender-mcp": "node scripts/setup-blender-mcp.mjs",
    "verify:blender-mcp": "node scripts/setup-blender-mcp.mjs --verify-only",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:notices": "node scripts/validate-notices.mjs",
    "audit:prod": "pnpm audit --prod",
    "test:web:csp": "node scripts/web-csp-journey.mjs",
    "validate:vsix": "node scripts/validate-vsix.mjs",
    "package:vsix:pre": "node scripts/package-vsix.mjs --pre-release"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@resvg/resvg-js": "^2.6.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.4.3"
  }
}
