{
  "name": "@codex-avatar-studio/asset-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./svg-safety": {
      "types": "./dist/src/svgSafety.d.ts",
      "import": "./dist/src/svgSafety.js",
      "default": "./dist/src/svgSafety.js"
    },
    "./trace-pixels": {
      "types": "./dist/src/tracePixels.d.ts",
      "import": "./dist/src/tracePixels.js",
      "default": "./dist/src/tracePixels.js"
    },
    "./raster-prep": {
      "types": "./dist/src/rasterPrep.d.ts",
      "import": "./dist/src/rasterPrep.js",
      "default": "./dist/src/rasterPrep.js"
    },
    "./optimize-svg": {
      "types": "./dist/src/optimizeSvg.d.ts",
      "import": "./dist/src/optimizeSvg.js",
      "default": "./dist/src/optimizeSvg.js"
    },
    "./optimize-svg/browser": {
      "types": "./dist/src/optimizeSvgBrowser.d.ts",
      "import": "./dist/src/optimizeSvgBrowser.js",
      "default": "./dist/src/optimizeSvgBrowser.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --workspace-root exec biome lint packages/asset-pipeline",
    "test": "pnpm --workspace-root exec vitest run packages/asset-pipeline"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "fast-xml-parser": "^5.9.3",
    "imagetracerjs": "1.2.6",
    "jimp": "0.14.0",
    "svgo": "^4.0.1"
  }
}
